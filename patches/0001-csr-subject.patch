+// The double replaces only lego's network boundary; CSR preparation and dispatch are real.
+type csrRenewalClient struct {
+	request *certificate.ObtainForCSRRequest
+	renewed bool
+	result  *certificate.Resource
+	err     error
+}
+
+func (c *csrRenewalClient) Renew(context.Context, certificate.Resource, *certificate.RenewOptions) (*certificate.Resource, error) {
+	c.renewed = true
+	return c.result, c.err
+}
+
+func (c *csrRenewalClient) ObtainForCSR(_ context.Context, request certificate.ObtainForCSRRequest) (*certificate.Resource, error) {
+	c.request = &request
+	return c.result, c.err
+}
+
+// The double replaces only lego's network boundary; path selection and CSR preparation are real.
+type csrObtainClient struct {
+	obtain       *certificate.ObtainRequest
+	obtainForCSR *certificate.ObtainForCSRRequest
+	result       *certificate.Resource
+	err          error
+}
+
+func (c *csrObtainClient) Obtain(_ context.Context, request certificate.ObtainRequest) (*certificate.Resource, error) {
+	c.obtain = &request
+	return c.result, c.err
+}
+
+func (c *csrObtainClient) ObtainForCSR(_ context.Context, request certificate.ObtainForCSRRequest) (*certificate.Resource, error) {
+	c.obtainForCSR = &request
+	return c.result, c.err
+}
