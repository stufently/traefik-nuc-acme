@@ -0,0 +1,438 @@
+package acme
+
+import (
+	"context"
+	"crypto"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"errors"
+	"math/big"
+	"net"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-acme/lego/v5/certcrypto"
+	"github.com/go-acme/lego/v5/certificate"
+)
+
+func csrTestKey(t *testing.T) crypto.Signer {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return key
+}
+
+func csrTestCertPEM(t *testing.T, key crypto.Signer, dnsNames []string) []byte {
+	t.Helper()
+	serial, err := rand.Int(rand.Reader, new(big.Int).Lsh(big.NewInt(1), 128))
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{
+		SerialNumber: serial,
+		Subject:      pkix.Name{CommonName: dnsNames[0]},
+		DNSNames:     dnsNames,
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(24 * time.Hour),
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, key.Public(), key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})
+}
+
+func TestCSRSubjectCountry(t *testing.T) {
+	csr, err := buildCSR(&CSRSubject{Country: "RU"}, []string{"example.org"}, nil, csrTestKey(t), true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(csr.Subject.Country, []string{"RU"}) {
+		t.Fatalf("country missing from signed CSR: %v", csr.Subject.Country)
+	}
+	if len(csr.Raw) == 0 {
+		t.Fatal("CSR.Raw is empty")
+	}
+	if err := csr.CheckSignature(); err != nil {
+		t.Fatal(err)
