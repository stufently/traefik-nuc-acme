diff --git a/cmd/validatecsr/validatecsr.go b/cmd/validatecsr/validatecsr.go
new file mode 100644
index 0000000..bc73702
--- /dev/null
+++ b/cmd/validatecsr/validatecsr.go
@@ -0,0 +1,46 @@
+// Package validatecsr checks ACME CSR subjects before Traefik starts.
+package validatecsr
+
+import (
+	"fmt"
+	"maps"
+	"os"
+	"slices"
+
+	"github.com/traefik/paerser/cli"
+	"github.com/traefik/traefik/v3/pkg/config/static"
+)
+
+// NewCmd builds a CSR subject validation command using Traefik's loaders.
+func NewCmd(cfg *static.Configuration, loaders []cli.ResourceLoader) *cli.Command {
+	return &cli.Command{
+		Name:          "validate-csr-subject",
+		Description:   "Validate all ACME CSR subjects before starting Traefik.",
+		Configuration: cfg,
+		Resources:     loaders,
+		Run: func(_ []string) error {
+			if err := Do(cfg); err != nil {
+				fmt.Fprintln(os.Stderr, err)
+				os.Exit(1)
+			}
+			fmt.Fprintln(os.Stdout, "csrSubject OK")
+			return nil
+		},
+	}
+}
+
+// Do validates every ACME resolver's subject without starting a server.
+func Do(cfg *static.Configuration) error {
+	// Stable ordering makes the first invalid resolver predictable.
+	names := slices.Sorted(maps.Keys(cfg.CertificatesResolvers))
+	for _, name := range names {
+		resolver := cfg.CertificatesResolvers[name]
+		if resolver.ACME == nil {
+			continue
+		}
+		if err := resolver.ACME.CSRSubject.Validate(); err != nil {
+			return fmt.Errorf("invalid CSR subject in resolver %q: %w", name, err)
+		}
+	}
+	return nil
+}
diff --git a/cmd/validatecsr/validatecsr_test.go b/cmd/validatecsr/validatecsr_test.go
new file mode 100644
index 0000000..46cd717
--- /dev/null
+++ b/cmd/validatecsr/validatecsr_test.go
@@ -0,0 +1,212 @@
+package validatecsr
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/traefik/paerser/cli"
+	"github.com/traefik/traefik/v3/cmd"
+	tcli "github.com/traefik/traefik/v3/pkg/cli"
+	"github.com/traefik/traefik/v3/pkg/config/static"
+	"github.com/traefik/traefik/v3/pkg/provider/acme"
+)
+
+func TestCSRGuardValidSubjects(t *testing.T) {
+	for _, subject := range []*acme.CSRSubject{nil, {}, {Country: "RU", Organization: "Example LLC"}} {
+		cfg := &static.Configuration{CertificatesResolvers: map[string]static.CertificateResolver{
+			"valid": {ACME: &acme.Configuration{CSRSubject: subject}},
+		}}
+		if err := Do(cfg); err != nil {
+			t.Fatalf("valid subject rejected: %v", err)
+		}
+	}
+}
+
+func TestCSRGuardInvalidCountry(t *testing.T) {
+	cfg := &static.Configuration{CertificatesResolvers: map[string]static.CertificateResolver{
+		"nuc": {ACME: &acme.Configuration{CSRSubject: &acme.CSRSubject{Country: "RUS"}}},
+	}}
+	err := Do(cfg)
+	if err == nil || err.Error() != `invalid CSR subject in resolver "nuc": CSR subject country must contain exactly two ASCII letters` {
+		t.Fatalf("invalid country error missing resolver or validation reason: %v", err)
+	}
+}
+
+func TestCSRGuardChecksAllResolvers(t *testing.T) {
+	cfg := &static.Configuration{CertificatesResolvers: map[string]static.CertificateResolver{
+		"a-valid":   {ACME: &acme.Configuration{CSRSubject: &acme.CSRSubject{Country: "RU"}}},
+		"b-invalid": {ACME: &acme.Configuration{CSRSubject: &acme.CSRSubject{Country: "RUS"}}},
+	}}
+	err := Do(cfg)
+	if err == nil || err.Error() != `invalid CSR subject in resolver "b-invalid": CSR subject country must contain exactly two ASCII letters` {
+		t.Fatalf("second resolver was not rejected: %v", err)
+	}
+}
+
+// The walk is sorted so the reported resolver is the same on every run: with
+// map order the guard would name a different resolver each time.
+func TestCSRGuardNamesFirstResolverInSortedOrder(t *testing.T) {
+	cfg := &static.Configuration{CertificatesResolvers: map[string]static.CertificateResolver{
+		"a-bad": {ACME: &acme.Configuration{CSRSubject: &acme.CSRSubject{Country: "RUS"}}},
+		"b-bad": {ACME: &acme.Configuration{CSRSubject: &acme.CSRSubject{Country: "RUX2"}}},
+	}}
+	err := Do(cfg)
+	if err == nil || !strings.Contains(err.Error(), `resolver "a-bad"`) {
+		t.Fatalf("guard did not report the first resolver in sorted order: %v", err)
+	}
+}
+
+// Validation is not about the country alone: a subject may be invalid on a
+// field the guard never looks at directly.
+func TestCSRGuardValidatesSubjectWithoutCountry(t *testing.T) {
+	cfg := &static.Configuration{CertificatesResolvers: map[string]static.CertificateResolver{
+		"nuc": {ACME: &acme.Configuration{CSRSubject: &acme.CSRSubject{Organization: strings.Repeat("o", 65)}}},
+	}}
+	err := Do(cfg)
+	if err == nil || !strings.Contains(err.Error(), "organization must not exceed 64 characters") {
+		t.Fatalf("subject without a country was not validated: %v", err)
+	}
+}
+
+// The whole point of the guard is reading the configuration Traefik reads:
+// the command must carry the caller's loader chain untouched, in order.
+func TestCSRGuardUsesGivenLoadersUnchanged(t *testing.T) {
+	loaders := []cli.ResourceLoader{&tcli.DeprecationLoader{}, &tcli.FileLoader{}, &tcli.FlagLoader{}, &tcli.EnvLoader{}}
+	got := NewCmd(&static.Configuration{}, loaders).Resources
+	if len(got) != len(loaders) {
+		t.Fatalf("loader chain resized: got %d, want %d", len(got), len(loaders))
+	}
+	for i := range loaders {
+		if got[i] != loaders[i] {
+			t.Fatalf("loader %d replaced: got %T, want %T", i, got[i], loaders[i])
+		}
+	}
+}
+
+// A resolver without ACME must be skipped, not end the walk: a stock resolver
+// sorted first would otherwise hide an invalid subject behind it.
+func TestCSRGuardKeepsWalkingPastNonACMEResolver(t *testing.T) {
+	cfg := &static.Configuration{CertificatesResolvers: map[string]static.CertificateResolver{
+		"a-stock":   {},
+		"b-invalid": {ACME: &acme.Configuration{CSRSubject: &acme.CSRSubject{Country: "RUS"}}},
+	}}
+	err := Do(cfg)
+	if err == nil || err.Error() != `invalid CSR subject in resolver "b-invalid": CSR subject country must contain exactly two ASCII letters` {
+		t.Fatalf("resolver after a non-ACME one was not checked: %v", err)
+	}
+}
+
+func TestCSRGuardWithoutACME(t *testing.T) {
+	cfg := &static.Configuration{CertificatesResolvers: map[string]static.CertificateResolver{"stock": {}}}
+	if err := Do(cfg); err != nil {
+		t.Fatalf("resolver without ACME rejected: %v", err)
+	}
+	if err := Do(&static.Configuration{}); err != nil {
+		t.Fatalf("configuration without resolvers rejected: %v", err)
+	}
+}
+
+// Exercise the real command and loaders in a child process so os.Exit and the
+// stdout/stderr contract are tested without replacing the exit function.
+func TestCSRGuardProcess(t *testing.T) {
+	if os.Getenv("TRAEFIK_CSR_GUARD_TEST") != "1" {
+		return
+	}
+	var args []string
+	for i, arg := range os.Args {
+		if arg == "--" {
+			args = os.Args[i+1:]
+			break
+		}
+	}
+	os.Args = append([]string{"traefik", "validate-csr-subject"}, args...)
+	cfg := cmd.NewTraefikConfiguration()
+	loaders := []cli.ResourceLoader{&tcli.DeprecationLoader{}, &tcli.FileLoader{}, &tcli.FlagLoader{}, &tcli.EnvLoader{}}
+	if err := cli.Execute(NewCmd(&cfg.Configuration, loaders)); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(2)
+	}
+	os.Exit(0)
+}
+
+func guardProcess(t *testing.T, dir string, env []string, args ...string) (int, string, string) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	child := exec.CommandContext(ctx, os.Args[0], append([]string{"-test.run=^TestCSRGuardProcess$", "--"}, args...)...)
+	child.Dir = dir
+	child.Env = append(os.Environ(), "TRAEFIK_CSR_GUARD_TEST=1", "HOME="+dir, "XDG_CONFIG_HOME="+dir)
+	child.Env = append(child.Env, env...)
+	var stdout, stderr bytes.Buffer
+	child.Stdout, child.Stderr = &stdout, &stderr
+	err := child.Run()
+	if ctx.Err() != nil {
+		t.Fatalf("guard process timed out: %v", ctx.Err())
+	}
+	if err != nil {
+		if _, ok := err.(*exec.ExitError); !ok {
+			t.Fatalf("could not run guard process: %v", err)
+		}
+	}
+	return child.ProcessState.ExitCode(), stdout.String(), stderr.String()
+}
+
+func TestCSRGuardExitStatus(t *testing.T) {
+	rc, stdout, stderr := guardProcess(t, t.TempDir(), nil, "--certificatesresolvers.nuc.acme.csrsubject.country=RUS")
+	if rc != 1 {
+		t.Fatalf("invalid subject exit code = %d, want 1; stdout=%q stderr=%q", rc, stdout, stderr)
+	}
+	if stdout != "" || !slices.Contains(strings.Split(stderr, "\n"), `invalid CSR subject in resolver "nuc": CSR subject country must contain exactly two ASCII letters`) {
+		t.Fatalf("invalid subject output: stdout=%q stderr=%q", stdout, stderr)
+	}
+}
+
+func TestCSRGuardSuccessOutput(t *testing.T) {
+	for _, args := range [][]string{nil, {"--certificatesresolvers.nuc.acme.csrsubject.country=RU"}} {
+		rc, stdout, stderr := guardProcess(t, t.TempDir(), nil, args...)
+		if rc != 0 || stdout != "csrSubject OK\n" {
+			t.Fatalf("valid configuration did not succeed: rc=%d stdout=%q stderr=%q", rc, stdout, stderr)
+		}
+	}
+}
+
+func TestCSRGuardConfigSources(t *testing.T) {
+	for _, source := range []string{"explicit-yaml", "explicit-toml", "auto-yaml", "env"} {
+		t.Run(source, func(t *testing.T) {
+			dir := t.TempDir()
+			var args, env []string
+			if source == "env" {
+				env = []string{"TRAEFIK_CERTIFICATESRESOLVERS_NUC_ACME_CSRSUBJECT_COUNTRY=RUS"}
+			} else {
+				name := "custom.yml"
+				content := "certificatesResolvers:\n  nuc:\n    acme:\n      csrSubject:\n        country: RUS\n"
+				if source == "explicit-toml" {
+					name = "custom.toml"
+					content = "[certificatesResolvers.nuc.acme.csrSubject]\ncountry = \"RUS\"\n"
+				}
+				if source == "auto-yaml" {
+					name = "traefik.yml"
+				}
+				path := filepath.Join(dir, name)
+				if err := os.WriteFile(path, []byte(content), 0o600); err != nil {
+					t.Fatal(err)
+				}
+				if source != "auto-yaml" {
+					args = []string{"--configfile=" + path}
+				}
+			}
+			rc, stdout, stderr := guardProcess(t, dir, env, args...)
+			if rc != 1 || stdout != "" || !bytes.Contains([]byte(stderr), []byte("invalid CSR subject in resolver \"nuc\": CSR subject country must contain exactly two ASCII letters\n")) {
+				t.Fatalf("configuration source was not validated: rc=%d stdout=%q stderr=%q", rc, stdout, stderr)
+			}
+		})
+	}
+}
diff --git a/pkg/provider/acme/csr.go b/pkg/provider/acme/csr.go
new file mode 100644
index 0000000..318369f
--- /dev/null
+++ b/pkg/provider/acme/csr.go
@@ -0,0 +1,202 @@
+package acme
+
+import (
+	"context"
+	"crypto"
+	"crypto/rand"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"net"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/go-acme/lego/v5/certcrypto"
+	"github.com/go-acme/lego/v5/certificate"
+)
+
+// CSRSubject contains optional subject fields for certificate requests.
+type CSRSubject struct {
+	Country            string `description:"Two-letter country code for the CSR subject." json:"country,omitempty" toml:"country,omitempty" yaml:"country,omitempty" export:"true"`
+	Organization       string `description:"Organization for the CSR subject." json:"organization,omitempty" toml:"organization,omitempty" yaml:"organization,omitempty" export:"true"`
+	OrganizationalUnit string `description:"Organizational unit for the CSR subject." json:"organizationalUnit,omitempty" toml:"organizationalUnit,omitempty" yaml:"organizationalUnit,omitempty" export:"true"`
+	Locality           string `description:"Locality for the CSR subject." json:"locality,omitempty" toml:"locality,omitempty" yaml:"locality,omitempty" export:"true"`
+}
+
+// IsEmpty reports whether the stock certificate request path should be used.
+func (s *CSRSubject) IsEmpty() bool {
+	return s == nil || (s.Country == "" && s.Organization == "" && s.OrganizationalUnit == "" && s.Locality == "")
+}
+
+// Validate checks the X.520 subject field length limits.
+func (s *CSRSubject) Validate() error {
+	if s == nil {
+		return nil
+	}
+
+	if s.Country != "" {
+		if len(s.Country) != 2 {
+			return errors.New("CSR subject country must contain exactly two ASCII letters")
+		}
+		for _, c := range s.Country {
+			if (c < 'A' || c > 'Z') && (c < 'a' || c > 'z') {
+				return errors.New("CSR subject country must contain exactly two ASCII letters")
+			}
+		}
+	}
+
+	for _, field := range []struct{ name, value string }{
+		{"organization", s.Organization},
+		{"organizationalUnit", s.OrganizationalUnit},
+		{"locality", s.Locality},
+	} {
+		if utf8.RuneCountInString(field.value) > 64 {
+			return fmt.Errorf("CSR subject %s must not exceed 64 characters", field.name)
+		}
+	}
+	return nil
+}
+
+func buildCSR(subject *CSRSubject, domains, emails []string, key crypto.Signer, enableCommonName bool) (*x509.CertificateRequest, error) {
+	if err := subject.Validate(); err != nil {
+		return nil, err
+	}
+	if len(domains) == 0 {
+		return nil, errors.New("cannot build CSR without domains")
+	}
+	if key == nil {
+		return nil, errors.New("cannot build CSR without a private key")
+	}
+
+	var dnsNames []string
+	var ipAddresses []net.IP
+	for _, altname := range domains {
+		if ip := net.ParseIP(altname); ip != nil {
+			ipAddresses = append(ipAddresses, ip)
+		} else {
+			dnsNames = append(dnsNames, altname)
+		}
+	}
+
+	template := &x509.CertificateRequest{
+		DNSNames:       dnsNames,
+		IPAddresses:    ipAddresses,
+		EmailAddresses: emails,
+	}
+	if len(domains[0]) <= 64 && enableCommonName {
+		template.Subject.CommonName = domains[0]
+	}
+	if subject != nil {
+		if country := strings.ToUpper(subject.Country); country != "" {
+			template.Subject.Country = []string{country}
+		}
+		if subject.Organization != "" {
+			template.Subject.Organization = []string{subject.Organization}
+		}
+		if subject.OrganizationalUnit != "" {
+			template.Subject.OrganizationalUnit = []string{subject.OrganizationalUnit}
+		}
+		if subject.Locality != "" {
+			template.Subject.Locality = []string{subject.Locality}
+		}
+	}
+
+	der, err := x509.CreateCertificateRequest(rand.Reader, template, key)
+	if err != nil {
+		return nil, fmt.Errorf("creating CSR: %w", err)
+	}
+	csr, err := x509.ParseCertificateRequest(der)
+	if err != nil {
+		return nil, fmt.Errorf("parsing CSR: %w", err)
+	}
+	return csr, nil
+}
+
+func (p *Provider) obtainForCSRRequest(ctx context.Context, domains []string) (certificate.ObtainForCSRRequest, crypto.Signer, error) {
+	if err := p.CSRSubject.Validate(); err != nil {
+		return certificate.ObtainForCSRRequest{}, nil, err
+	}
+	key, err := certcrypto.GeneratePrivateKey(GetKeyType(ctx, p.KeyType))
+	if err != nil {
+		return certificate.ObtainForCSRRequest{}, nil, fmt.Errorf("generating CSR private key: %w", err)
+	}
+	request, err := p.csrRequest(domains, key)
+	return request, key, err
+}
+
+func (p *Provider) csrRequest(domains []string, key crypto.Signer) (certificate.ObtainForCSRRequest, error) {
+	csr, err := buildCSR(p.CSRSubject, domains, p.EmailAddresses, key, !p.DisableCommonName)
+	if err != nil {
+		return certificate.ObtainForCSRRequest{}, err
+	}
+	return certificate.ObtainForCSRRequest{
+		CSR:              csr,
+		PrivateKey:       key,
+		Bundle:           true,
+		PreferredChain:   p.PreferredChain,
+		EnableCommonName: !p.DisableCommonName,
+		Profile:          p.Profile,
+	}, nil
+}
+
+// renewalForCSRRequest prepares a renewal without contacting the CA or modifying
+// stored state. A nil request selects lego's stock Renew path.
+func (p *Provider) renewalForCSRRequest(res certificate.Resource) (*certificate.ObtainForCSRRequest, error) {
+	if p.CSRSubject.IsEmpty() {
+		return nil, nil
+	}
+	key, err := certcrypto.ParsePEMPrivateKey(res.PrivateKey)
+	if err != nil {
+		return nil, fmt.Errorf("parsing saved certificate private key: %w", err)
+	}
+	certificates, err := certcrypto.ParsePEMBundle(res.Certificate)
+	if err != nil {
+		return nil, fmt.Errorf("parsing saved certificate: %w", err)
+	}
+	request, err := p.csrRequest(certcrypto.ExtractDomains(certificates[0]), key)
+	if err != nil {
+		return nil, err
+	}
+	return &request, nil
+}
+
+type certificateRenewer interface {
+	Renew(context.Context, certificate.Resource, *certificate.RenewOptions) (*certificate.Resource, error)
+	ObtainForCSR(context.Context, certificate.ObtainForCSRRequest) (*certificate.Resource, error)
+}
+
+func (p *Provider) renewCertificate(ctx context.Context, client certificateRenewer, res certificate.Resource, opts *certificate.RenewOptions) (*certificate.Resource, error) {
+	request, err := p.renewalForCSRRequest(res)
+	if err != nil {
+		return nil, err
+	}
+	if request == nil {
+		return client.Renew(ctx, res, opts)
+	}
+	return client.ObtainForCSR(ctx, *request)
+}
+
+type certificateObtainer interface {
+	Obtain(context.Context, certificate.ObtainRequest) (*certificate.Resource, error)
+	ObtainForCSR(context.Context, certificate.ObtainForCSRRequest) (*certificate.Resource, error)
+}
+
+func (p *Provider) obtainCertificate(ctx context.Context, client certificateObtainer, domains []string) (*certificate.Resource, error) {
+	if p.CSRSubject.IsEmpty() {
+		request := certificate.ObtainRequest{
+			Domains:          domains,
+			Bundle:           true,
+			EmailAddresses:   p.EmailAddresses,
+			Profile:          p.Profile,
+			PreferredChain:   p.PreferredChain,
+			EnableCommonName: !p.DisableCommonName,
+			KeyType:          GetKeyType(ctx, p.KeyType),
+		}
+		return client.Obtain(ctx, request)
+	}
+	request, _, err := p.obtainForCSRRequest(ctx, domains)
+	if err != nil {
+		return nil, err
+	}
+	return client.ObtainForCSR(ctx, request)
+}
