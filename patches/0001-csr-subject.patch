+func TestCSRRequestPrivateKey(t *testing.T) {
+	p := &Provider{Configuration: &Configuration{CSRSubject: &CSRSubject{Country: "RU"}, KeyType: "EC256", Profile: "profile", PreferredChain: "chain", EmailAddresses: []string{"admin@example.org"}}}
+	request, key, err := p.obtainForCSRRequest(context.Background(), []string{"example.org"})
