+	if !request.Bundle || !request.EnableCommonName || request.Profile != "profile" || request.PreferredChain != "chain" || !reflect.DeepEqual(request.CSR.EmailAddresses, []string{"admin@example.org"}) {
+		t.Fatalf("issuance options lost: %+v", request)
